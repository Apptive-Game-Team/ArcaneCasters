# Test-environment database configuration, read by the `test-env` skill.
#
# Copy to `.db.env` in the monorepo root and fill in. `.db.env` matches the
# root .gitignore `*.env` rule, so the filled copy is never committed.
#
#   cp .db.env.example .db.env
#
# The values come from the submodule .env files already on this machine; the
# skill can fill them in for you. See, for the mapping and the dev-by-default
# rule, .claude/skills/test-env/references/initialize-db-env.md
#
# Keep this template free of real hosts and credentials (AGENTS.md section 4).
#
# The skill only ever READS the source database (pg_dump). It never writes to
# it, never migrates it, and never drops it. Everything it creates lives in
# local Docker containers.

# ---------------------------------------------------------------------------
# Source: the database to clone from.
# ---------------------------------------------------------------------------

# Free-text label shown in the confirmation prompt before any dump runs.
# Make it unmistakable, e.g. `dev` or `PRODUCTION`.
SOURCE_LABEL=dev

# Accepts a `jdbc:`, `r2dbc:`, or bare `postgresql://` URL, so you can paste
# the value straight out of game/.env or lobby/.env.
SOURCE_DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
SOURCE_DATABASE_USER=
SOURCE_DATABASE_PASSWORD=

# Optional. Only needed when running the `account` server, which uses its own
# separate database. Leave empty to skip cloning it.
SOURCE_ACCOUNT_DATABASE_URL=
SOURCE_ACCOUNT_DATABASE_USER=
SOURCE_ACCOUNT_DATABASE_PASSWORD=

# Extra flags appended to pg_dump. Useful to skip bulky history tables:
#   SOURCE_DUMP_ARGS=--exclude-table-data=match_history
SOURCE_DUMP_ARGS=

# ---------------------------------------------------------------------------
# Target: the local clone. Defaults are fine unless the ports are taken.
# ---------------------------------------------------------------------------

LOCAL_DB_PORT=55432
LOCAL_DB_NAME=wordonline_test
LOCAL_ACCOUNT_DB_NAME=account_test
LOCAL_DB_USER=wordonline
LOCAL_DB_PASSWORD=wordonline
LOCAL_REDIS_PORT=56379

# Where the game and lobby servers listen. The skill passes these as
# --server.port and ignores the PORT= line in each module's .env, which is
# gitignored and so differs per developer. The Unity client hardcodes its local
# entries at these numbers (MatchingServerOption.Local is localhost:6209), so a
# server on any other port is simply unreachable from the client, with no error
# that names the port. Change them only if the client changes too.
LOCAL_LOBBY_PORT=6209
LOCAL_GAME_PORT=7777

# Every module defaults its actuator/Prometheus port to 8081, so running more
# than one server locally collides. Each module gets BASE+1..BASE+4 instead.
LOCAL_MANAGEMENT_PORT_BASE=58080

# Postgres image for the local clone and for the pg_dump/pg_restore client.
# Leave empty to match the source server's major version automatically, which
# is what you want: pg_restore refuses a dump from a newer server.
LOCAL_POSTGRES_IMAGE=

# Flyway image used to apply database/migration against the local clone.
FLYWAY_IMAGE=flyway/flyway:11

# Optional. Migration directory to apply to the cloned ACCOUNT database, as a
# path relative to the monorepo root. Normally leave this empty: the account
# server carries its own Flyway chain and migrates at startup, so running it
# against the clone is enough. Set it only to migrate the account clone without
# starting the server, e.g. account/src/main/resources/db/migration.
#
# Never point this at database/migration. That chain targets the shared game
# database only (database/README.md) and would corrupt the account clone.
ACCOUNT_MIGRATION_DIR=
